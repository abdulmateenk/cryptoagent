# ---- Crypto Watch Portal settings ----
# Copy to .env (or paste into your hosting dashboard's "Environment Variables").

# Protect your portal (strongly recommended once deployed)
PORTAL_USER=admin
PORTAL_PASSWORD=change-me-to-something-long

# Your money & risk
ACCOUNT_USD=100            # your trading balance in USD
RISK_PER_TRADE_USD=2       # max you lose if a stop-loss is hit
MAX_LEVERAGE=3             # cap for leverage suggestions (1 = spot only)
ALLOW_SHORTS=true          # false = only LONG (buy) setups

# Coins
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,TRXUSDT
SCAN_HOT=true              # add today's biggest movers
HOT_TOP_N=10
SCAN_CHEAP=true            # add low-price coins with high volume
CHEAP_MAX_PRICE=1
CHEAP_TOP_N=8

# Timing
SCAN_INTERVAL_MIN=5        # how often the agent checks the market
ENTRY_WINDOW_HOURS=2       # how long a setup stays valid to enter
SIGNAL_EXPIRY_HOURS=12     # "close by" time for each trade
MIN_CONFIDENCE=60

# Pre-trade benchmark (each setup is backtested on the coin's last ~40 days)
BT_MIN_TRADES=6            # at least this many past examples
BT_MIN_WIN_RATE=45         # % of past trades that made money
BT_MIN_AVG_R=0.15          # average result per trade (R = amount risked)
BT_MIN_PROFIT_FACTOR=1.2   # total wins / total losses

# Extra risk limits
MAX_OPEN_TRADES=3          # no new signals while you have this many open trades
MIN_VOLUME_USD=5000000     # skip coins with less 24h volume
BTC_GUARD=true             # no alt longs while BTC dumps (no shorts while it pumps)
TIMEZONE=Asia/Karachi

# Telegram alerts (optional - alerts even when the portal is closed)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to true to preview with simulated prices
DEMO=false
